# Anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Authenticatie — VERPLICHT en UNIEK in productie (Railway).
# JWT_SECRET_KEY: minimaal 32 tekens. Genereer met: openssl rand -hex 32
# De app start NIET zonder een geldige JWT_SECRET_KEY.
JWT_SECRET_KEY=REPLACE_ME_min_32_tekens_openssl_rand_hex_32
# ADMIN_INIT_WACHTWOORD: wachtwoord voor het eerste admin-account (eenmalige seed).
# Zonder deze var wordt er GEEN admin aangemaakt. Wijzig het wachtwoord na eerste login.
ADMIN_INIT_WACHTWOORD=REPLACE_ME_sterk_uniek_wachtwoord

# Neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=your-username
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=your-database

# PostgreSQL
POSTGRES_USER=benwa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=benwa_intelligence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://benwa:changeme@postgres:5432/benwa_intelligence

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Services
SEMANTIC_AIRLOCK_PORT=8001
BELIEF_STATE_ENGINE_PORT=8002
SOLVER_ENGINE_PORT=8003
INGESTION_GATEWAY_PORT=8004

# Autonome modus: true = wijzigingen meteen toepassen, false = eerst bevestigen
AUTONOME_MODUS=false

# Web-push (VAPID) — genereer met: python3 -c "zie push.py docstring"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:jouw@email.nl

# Weerbewaking: locatie van de bouwplaats (standaard regio Ravels)
WEER_LAT=51.37
WEER_LON=4.99
